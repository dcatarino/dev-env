#!/usr/bin/env bash

# Runs Claude Code or Codex inside a Herdr server instead of directly in the
# terminal. The agent then keeps running when the terminal (or Cursor) closes,
# and a herdr client (see herdr-codespaces) shows whether it is working,
# blocked on a question, or done.
#
# In a Codespace the agent runs in the Codespace's Herdr server. On a computer
# that runs herdr-codespaces it runs in that window's session, so local agents
# appear next to the Codespaces' agents.
#
# Usage:
#   herd [claude|codex] [NAME] [-- AGENT_ARGS...]   start an agent here, attach
#   herd attach NAME                                 reattach to a running agent
#   herd ls                                          list agents and their state
#
# Detach with ctrl+b q; the agent keeps running. remote-codespace-setup.sh (in
# a Codespace) and setup.sh (on a computer) link this into ~/.local/bin.

set -euo pipefail

herdr_bin=${HERDR_BIN:-herdr}

# A Herdr pane sets TERM_PROGRAM=herdr; other terminals overwrite it (Cursor's
# sets vscode). A pane's variables without it were inherited, for example by a
# Cursor window opened from a Herdr pane, and would make this terminal pass for
# a pane. Its HERDR_SESSION still names the window it came from, so it stays.
if [[ "${TERM_PROGRAM:-}" != herdr ]]; then
  unset HERDR_ENV HERDR_PANE_ID HERDR_TAB_ID HERDR_WORKSPACE_ID
fi

# Inside a Herdr pane HERDR_SESSION already names the current session.
# herdr-codespaces opens the same session name (HERDR_SESSION, or codespaces).
if [[ -z "${HERDR_SESSION:-}" && -z "${CODESPACES:-}" && ! -d /workspaces/.codespaces ]]; then
  export HERDR_SESSION=codespaces
fi

source_path=${BASH_SOURCE[0]}
while [[ -L "$source_path" ]]; do
  source_dir=$(cd -P "$(dirname "$source_path")" && pwd)
  source_path=$(readlink "$source_path")
  [[ "$source_path" == /* ]] || source_path=$source_dir/$source_path
done
client_config=$(cd -P "$(dirname "$source_path")" && pwd)/herd-client.toml

die() {
  printf 'herd: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage:
  herd [claude|codex] [NAME] [-- AGENT_ARGS...]   start an agent here and attach
  herd attach NAME                                 reattach to a running agent
  herd ls                                          list agents and their state

The agent runs in this Codespace's Herdr server, or on a computer in the
herdr-codespaces window's session, so it survives closing the terminal and is
visible in the herdr-codespaces window. Inside a Herdr pane, the window
switches to the agent instead of opening a second Herdr in the pane.
Detach with ctrl+b q. NAME defaults to the current folder name.
USAGE
}

herdr_json() {
  # Herdr prints API errors as JSON on stderr; keep them for error reporting.
  "$herdr_bin" "$@" 2>&1
}

error_code() {
  jq -r '.error.code // empty' <<<"$1" 2>/dev/null || true
}

# Not `grep -q`: it exits at the first line, herdr then dies of SIGPIPE writing
# the rest of its status, and pipefail reports a running server as stopped.
server_running() {
  "$herdr_bin" status server 2>/dev/null | grep '^status: running' >/dev/null
}

ensure_server() {
  server_running && return 0

  # Herdr's server ignores SIGHUP; a new session also keeps it out of this
  # terminal's job control, so closing the terminal never stops the agents.
  if command -v setsid >/dev/null 2>&1; then
    setsid "$herdr_bin" server >/dev/null 2>&1 </dev/null &
  else
    nohup "$herdr_bin" server >/dev/null 2>&1 </dev/null &
  fi

  local _
  for _ in $(seq 1 50); do
    server_running && return 0
    sleep 0.1
  done
  die "the herdr server did not start"
}

# Opens the focused workspace in a Herdr client in this terminal. A direct
# `herdr terminal attach` would set the agent's terminal size for as long as it
# stays attached, so herdr-codespaces on another machine would show the agent
# at this terminal's size. Clients share it instead: the one used last sets the
# size. herd-client.toml hides the sidebar and tab row, so the agent still
# fills this terminal like a plain session.
#
# Inside a Herdr pane, focusing the workspace already switched this window to
# the agent; a client here would nest Herdr inside its own pane.
open_client() {
  if [[ "${HERDR_ENV:-}" == 1 ]]; then
    printf 'herd: switched this Herdr window to the agent.\n'
    exit 0
  fi
  HERDR_CONFIG_PATH=$client_config exec "$herdr_bin"
}

live_agent_names() {
  herdr_json agent list | jq -r '.result.agents[]?.name // empty'
}

# Herdr agent names must match [a-z][a-z0-9_-]{0,31}.
default_name() {
  local base existing candidate index=1
  base=$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '-')
  base=${base%-}
  [[ "$base" =~ ^[a-z] ]] || base="agent-$base"
  base=${base:0:28}
  base=${base%-}
  existing=$(live_agent_names)

  candidate=$base
  while grep -Fqx -- "$candidate" <<<"$existing"; do
    index=$((index + 1))
    candidate="${base}-${index}"
  done
  printf '%s\n' "$candidate"
}

start_agent() {
  local kind=claude name=""
  local -a agent_args=()

  if [[ "${1:-}" == claude || "${1:-}" == codex ]]; then
    kind=$1
    shift
  fi
  if (( $# > 0 )) && [[ "$1" != -- ]]; then
    name=$1
    shift
  fi
  if (( $# > 0 )); then
    [[ "$1" == -- ]] || die "unexpected argument: $1 (see herd --help)"
    shift
    agent_args=("$@")
  fi

  ensure_server
  [[ -n "$name" ]] || name=$(default_name)
  [[ "$name" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] \
    || die "invalid name '$name': use lowercase letters, digits, - or _ (max 32)"
  if live_agent_names | grep -Fx -- "$name" >/dev/null; then
    die "an agent named '$name' is already running; use: herd attach $name"
  fi

  local created workspace pane
  created=$(herdr_json workspace create --cwd "$PWD" --label "$name" --no-focus)
  workspace=$(jq -r '.result.workspace.workspace_id // empty' <<<"$created" 2>/dev/null) \
    || workspace=""
  pane=$(jq -r '.result.root_pane.pane_id // empty' <<<"$created" 2>/dev/null) || pane=""
  [[ -n "$workspace" && -n "$pane" ]] || die "could not create a herdr workspace: $created"

  # A new pane is ready for an agent only once its shell owns the foreground.
  # The pane's interactive shell also loads the sandboxed claude alias.
  local started code attempt
  for attempt in $(seq 1 50); do
    if started=$(herdr_json agent start "$name" --kind "$kind" --pane "$pane" \
      -- ${agent_args[@]+"${agent_args[@]}"}); then
      break
    fi
    code=$(error_code "$started")
    case "$code" in
      agent_pane_busy)
        (( attempt < 50 )) || die "the new pane did not become ready: $started"
        sleep 0.2
        ;;
      agent_not_ready)
        # The agent is waiting for an answer (for example Claude's folder
        # trust prompt); attach so it can be answered.
        break
        ;;
      *)
        printf 'herd: could not start %s: %s\n' "$kind" "$started" >&2
        printf 'herd: attaching to the pane so you can see what happened.\n' >&2
        break
        ;;
    esac
  done

  # A new client opens on the server's focused workspace. Focusing moves every
  # client of this server to it (Herdr has no per-client focus), so focus last,
  # right before attaching.
  "$herdr_bin" workspace focus "$workspace" >/dev/null
  open_client
}

main() {
  command -v "$herdr_bin" >/dev/null 2>&1 \
    || die "herdr is not installed; rerun the dev-env Codespace bootstrap"
  command -v jq >/dev/null 2>&1 || die "jq is required"

  case "${1:-}" in
    -h|--help|help)
      usage
      ;;
    ls|list)
      (( $# == 1 )) || die "usage: herd ls"
      server_running || { printf 'No herdr server is running.\n'; return 0; }
      herdr_json agent list | jq -r '
        ["NAME", "AGENT", "STATE", "FOLDER"],
        (.result.agents[]? | [(.name // .pane_id), .agent, .agent_status, .cwd])
        | @tsv'
      ;;
    attach)
      (( $# == 2 )) || die "usage: herd attach NAME"
      server_running || die "no herdr server is running"
      local focused
      focused=$(herdr_json agent focus "$2") || die "could not attach to $2: $focused"
      open_client
      ;;
    *)
      start_agent "$@"
      ;;
  esac
}

main "$@"
